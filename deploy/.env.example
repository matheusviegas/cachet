# Copie para .env e restrinja: chmod 600 .env
# Este arquivo é usado pelo Compose (interpolação) e injetado nos containers.

# --- Compose -----------------------------------------------------------------
# IP do host onde a porta 8080 será publicada. Use o IP da interface privada
# que o nginx de borda alcança, em vez de 0.0.0.0.
CACHET_BIND_IP=0.0.0.0

# --- Aplicação ---------------------------------------------------------------
APP_NAME=Cachet
# Gere com: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_URL=https://status.example.com
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

LOG_LEVEL=warning

# IP(s) do nginx de borda, separados por vírgula. Necessário para o Laravel
# confiar em X-Forwarded-For/Proto e gerar URLs https corretas.
CACHET_TRUSTED_PROXIES=10.0.0.10

# Telemetria anônima do Cachet
CACHET_BEACON=false

# --- Sessão ------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# true exige HTTPS no navegador (nginx de borda). Use false só para teste local em http.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# --- Cache / fila (SQLite) ---------------------------------------------------
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# --- E-mail ------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS="status@example.com"
MAIL_FROM_NAME="${APP_NAME}"
